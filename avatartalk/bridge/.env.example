# ---- どちらのバックエンドで動かすか ----------------------------------------
#   agent : Claude Agent SDK 経由（Claude Code のログイン＝Pro/Max サブスクを使う）
#           → トークン従量課金なし。Pro のレート制限の範囲内で動く。
#   api   : Anthropic API を直接叩く（API キー必要／トークン従量課金）
BACKEND=agent

# ---- 共通 ------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# iOS アプリが Authorization: Bearer <この値> で送ってくる合言葉。
# 必ず自分で長いランダム文字列に変えること。
BRIDGE_TOKEN=change-me-to-a-long-random-string
# 応答の長さの上限（音声で読み上げるので短めが気持ちいい）
MAX_REPLY_TOKENS=2000
# 1 セッションが記憶する往復数（api モードのみ。agent モードは SDK 側が持つ）
HISTORY_TURNS=20

# ---- agent モード ----------------------------------------------------------
# 事前に `claude setup-token` で発行したトークン。
# 省略した場合は、このマシンの `claude` ログイン情報がそのまま使われる。
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# ---- api モード ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-api03-...
MODEL=claude-opus-5
